#!/bin/bash

#=================================================
# IMPORT GENERIC HELPERS
#=================================================

source /usr/share/yunohost/helpers

nut_ups_name="ups"
nut_ups_desc="My UPS"
nut_driver="usbhid-ups"
nut_listen_addr="127.0.0.1"
nut_listen_port="$port"

#=================================================
# CHECK IF NUT IS ALREADY INSTALLED
#=================================================

if [ "$install_only" = "0" ]; then
    if [ -d /etc/nut ]; then
        ynh_die "NUT is already installed or was installed but /etc/nut is still present."
    fi   
    apt-get install -y --no-install-recommends \
        nut-server nut-client
    sleep 30
    cp --archive "../conf/nut/." /"/etc/nut/"
    mkdir -p /etc/nut/notify.d /var/log/nut

    cp "$install_dir/scripts/notifycmd.sh" /etc/nut/notifycmd.sh
    chmod 750 /etc/nut/notifycmd.sh

    install -o root -g root -m 755 "$install_dir/scripts/nutwatch-wol-dispatch" /usr/local/bin/nutwatch-wol-dispatch
    ynh_replace --match="/opt/nutwatch" --replace="$install_dir" --file=/usr/local/bin/nutwatch-wol-dispatch
    chown -R root:nut /etc/nut
    usermod -aG nut "$app"
    setfacl -R -m u:nut:rX "$install_dir"
    
fi

#=================================================
# DOWNLOAD, CHECK AND UNPACK SOURCE
#=================================================
ynh_script_progression "Setting up source files..."

    ynh_setup_source --dest_dir="$install_dir"

#=================================================
# INSTALL AND BUILD THE APP
#=================================================

ynh_script_progression "Installing and building the $app's backend..."

pushd "$install_dir"

  python3 -m venv venv
  source venv/bin/activate
  ynh_script_progression "Installing python dependencies..."
  ynh_hide_warnings pip install --no-cache-dir -r requirements.txt
popd 

#=================================================
# SYSTEM CONFIGURATION
#=================================================
ynh_script_progression "Adding system configurations related to $app..."

    ynh_config_add_systemd
    yunohost service add $app --description="Nutwatch Dashboard" --log="/var/log/$app/$app.log"
    ynh_config_add_logrotate
    
    ynh_config_add_nginx

#=================================================
# START SYSTEMD SERVICE
#=================================================
ynh_script_progression "Starting $app's systemd service..."

    ynh_systemctl --service="$app" --action="start"

    systemctl enable nut-server nut-monitor --quiet 2>/dev/null || true
    systemctl start "nut-driver@${nut_ups_name}" 2>/dev/null || true
    systemctl restart nut-server nut-monitor 2>/dev/null || true


#=================================================
# END OF SCRIPT
#=================================================

ynh_script_progression "Installation of $app completed"
